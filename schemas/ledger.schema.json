{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal-loop/ledger@2",
  "title": "goal-loop run ledger",
  "type": "object",
  "required": [
    "schema", "run_id", "created_at", "items", "recovery_remaining",
    "consecutive_blocked", "reconciled", "merge_barrier", "stop"
  ],
  "properties": {
    "schema": { "const": "goal-loop/ledger@2" },
    "run_id": { "type": "string" },
    "created_at": { "type": "string" },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state", "history"],
        "properties": {
          "state": {
            "enum": [
              "pending", "in_progress", "implemented", "pr_opened", "ready",
              "merged", "released", "deployed", "blocked", "abandoned"
            ]
          },
          "blocked_theme": { "type": "string" },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at", "from", "to", "engine"],
              "properties": {
                "at": { "type": "string" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "engine": { "enum": ["claude", "codex"] },
                "theme": { "type": "string" },
                "evidence": { "type": "object" },
                "note": { "type": "string" },
                "recovery_charged": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "recovery_remaining": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "consecutive_blocked": { "type": "integer", "minimum": 0 },
    "reconciled": {
      "type": ["object", "null"],
      "properties": {
        "at": { "type": "string" },
        "seq": { "type": "integer" },
        "base_sha": { "type": ["string", "null"] },
        "truth": { "type": "object" },
        "mismatches": { "type": "array" }
      }
    },
    "merge_barrier": {
      "type": ["object", "null"],
      "required": ["item", "merged_sha", "set_at"],
      "properties": {
        "item": { "type": "string" },
        "merged_sha": { "type": "string" },
        "set_at": { "type": "string" }
      }
    },
    "stop": {
      "type": ["object", "null"],
      "properties": { "reason": { "type": "string" } }
    }
  }
}
